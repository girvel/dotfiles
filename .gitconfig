[user]
	name = girvel
	email = widauka@ya.ru
[push]
	autoSetupRemote = true
[core]
	editor = nvim
	autocrlf = input
[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true
[commit]
	verbose = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[init]
	defaultBranch = master
# [https]
#     proxy = "socks5h://192.168.0.240:1080"
# [http]
#     proxy = "socks5h://192.168.0.240:1080"
[pull]
	rebase = false
